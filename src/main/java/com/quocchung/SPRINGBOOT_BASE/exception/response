public class ResourceNotFoundException extends  RuntimeException {

  + khởi tạo một cái exception mà không có thông báo lỗi hoặc nguyên nhân.
  + bạn chỉ muốn ném ra ngoại lệ mà không cần cung câp thông tin chi tiết.
  + throw new ResourceNotFoundException();
  public ResourceNotFoundException() {
  }


  + Khởi tạo exception với một thông báo cụ thể.
  + message: Mô tả lỗi (thường là chuỗi mô tả cụ thể lỗi gì xảy ra).
  + throw new ResourceNotFoundException("Không tìm thấy tài nguyên có ID 123");
  public ResourceNotFoundException(String message) {
    super(message);
  }


  + Kết hợp cả mô tả lỗi và ngoại lệ gốc (dùng để giữ trace lỗi rõ ràng).
  + message: Thông báo lỗi.
  + cause: Nguyên nhân gốc (một exception khác gây ra exception này).
  + try {
        someCode();
    } catch (SQLException e) {
        throw new ResourceNotFoundException("Không tìm thấy tài nguyên trong CSDL", e);
    }
  public ResourceNotFoundException(String message, Throwable cause) {
    super(message, cause);
  }



  + Tạo exception chỉ với nguyên nhân gốc mà không cần thông báo.
  + Bạn không quan tâm đến thông báo mô tả, chỉ cần lưu lại nguyên nhân lỗi.
  + cause: Nguyên nhân gây lỗi.
  public ResourceNotFoundException(Throwable cause) {
    super(cause);
  }



  + message: Thông báo lỗi.
  + cause: Nguyên nhân gây lỗi.
  + enableSuppression: Cho phép hoặc không cho phép suppressed exceptions (Java 7+).
  + writableStackTrace: Cho phép hoặc không cho phép ghi stack trace.
  + throw new ResourceNotFoundException("Lỗi nghiêm trọng", cause, false, false);

  public ResourceNotFoundException(String message, Throwable cause, boolean enableSuppression,
      boolean writableStackTrace) {
    super(message, cause, enableSuppression, writableStackTrace);
  }
}
